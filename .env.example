# Local development (next dev). Copy to .env.local. Never commit real values.
APP_ENV=development
APP_URL=http://localhost:3000

# Postgres: a Neon branch URL, or a local Postgres with DATABASE_DRIVER=pg
DATABASE_URL=postgres://postgres@localhost:5433/hotelawise_dev
DATABASE_DRIVER=pg
# Used by `pnpm db:migrate` in CI (direct, non-pooled Neon URL)
DATABASE_URL_MIGRATE=

# 32+ random characters each: openssl rand -base64 48
BETTER_AUTH_SECRET=
REF_SECRET=

# Email (Resend). Without a key, development prints emails to the console.
RESEND_API_KEY=
EMAIL_FROM="Hotel A-Wise <bookings@hotelawise.com>"

# Paystack: test keys on preview, live keys on production only
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis (rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# SMS (off unless set): arkesel | hubtel
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# First Super Admin (scripts/create-super-admin.ts)
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_TEMP_PASSWORD=

# Password for the preview site (any username). Only used when APP_ENV=preview.
PREVIEW_PASSWORD=
