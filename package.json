{
  "name": "hotelawise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hotel A-Wise website, booking engine and admin CMS",
  "author": "WISDOMSKA(SENYA)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "design:capture": "node scripts/design/capture-reference.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "node scripts/copy-photos.mjs && HOTELAWISE_WORKER_BUILD=1 opennextjs-cloudflare build",
    "cf:deploy:preview": "node scripts/cf-clean-build.mjs --env preview && opennextjs-cloudflare deploy --env preview",
    "cf:deploy:production": "node scripts/cf-clean-build.mjs --env production && opennextjs-cloudflare deploy --env production",
    "cf:preview": "node scripts/copy-photos.mjs && HOTELAWISE_WORKER_BUILD=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create-super-admin.ts",
    "images:import": "tsx scripts/import-images.ts",
    "prebuild": "node scripts/copy-photos.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^6.0.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@neondatabase/serverless": "^1.2.1",
    "@opennextjs/cloudflare": "^1.20.18",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "^1.7.27",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.0",
    "resend": "^6.39.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "uqr": "0.1.3",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml,jsonc}": [
      "prettier --write"
    ]
  }
}
